# ============================================================
# MedVision AI — Variables de Entorno
# ============================================================
# NUNCA subir .env al repositorio (incluido en .gitignore)
# Copiar: cp .env.example .env
# Editar credenciales antes de producción
# ============================================================

# --- General ---
APP_ENV=development
DEBUG=true
SECRET_KEY=cambiar-por-clave-segura-aleatoria

# --- API FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medvision
POSTGRES_USER=medvision_user
POSTGRES_PASSWORD=medvision_dev_2024

# --- MinIO (S3-compatible) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=medvision_minio
MINIO_SECRET_KEY=medvision_minio_secret_2024
MINIO_BUCKET=medical-images
MINIO_SECURE=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=medvision-detection
MLFLOW_PORT=5000

# --- Modelo ---
MODEL_PATH=checkpoints/best_model.pth
MODEL_ARCHITECTURE=efficientnet_b4
NUM_CLASSES=2
IMAGE_SIZE=224
CONFIDENCE_THRESHOLD=0.5

# --- Gradio ---
GRADIO_PORT=7860
GRADIO_SHARE=false

# --- Reproducibilidad ---
RANDOM_SEED=42

# --- GPU (CUDA 11.8) ---
CUDA_VISIBLE_DEVICES=0
