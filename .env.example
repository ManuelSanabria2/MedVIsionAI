# ============================================================
# MedVision AI - Variables de Entorno
# NUNCA subir el archivo .env real al repositorio
# Copiar este archivo como .env y completar los valores
# ============================================================

# --- General ---
APP_ENV=development
DEBUG=true
SECRET_KEY=cambiar-por-clave-segura-aleatoria

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Base de Datos PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medvision
POSTGRES_USER=medvision_user
POSTGRES_PASSWORD=cambiar-password-seguro

# --- MinIO (Almacenamiento de Imágenes) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=cambiar-secret-seguro
MINIO_BUCKET=medical-images
MINIO_SECURE=false

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=medvision-detection

# --- Modelo ---
MODEL_PATH=checkpoints/best_model.pth
MODEL_ARCHITECTURE=efficientnet_b4
NUM_CLASSES=2
IMAGE_SIZE=224
CONFIDENCE_THRESHOLD=0.5

# --- Gradio ---
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false

# --- Reproducibilidad ---
RANDOM_SEED=42
